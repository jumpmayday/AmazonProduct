# 复制为 .env 后填写。不要把填好的 .env 提交到 Git。

# Login with Amazon 凭证。在 Solution Provider Portal 的应用详情里查看。
LWA_CLIENT_ID=
LWA_CLIENT_SECRET=

# 私有应用自授权后得到的刷新令牌。只显示一次。
SP_API_REFRESH_TOKEN=

# 区域：na（北美）、eu（欧洲）、fe（远东）
SP_API_REGION=na

# 逗号分隔的 Marketplace ID。默认美国站。
SP_API_MARKETPLACE_IDS=ATVPDKIKX0DER

# 定时抓取间隔（小时）。默认 6。实际最小间隔 15 分钟。
SYNC_INTERVAL_HOURS=6

# 第一次抓取向前回看的天数，最长 730（订单接口只保留约两年）。
SYNC_LOOKBACK_DAYS=30

# true 时进程启动后立刻抓一次。默认只等定时任务或页面上的「立即抓取」。
SYNC_ON_STARTUP=false

DATABASE_PATH=data/sales.db

# 订单按下单时间归到这个 IANA 时区的日期。例如 Asia/Shanghai、America/Los_Angeles。
SALES_TIMEZONE=UTC

# 只监听本机。销量数据留在本机。
HOST=127.0.0.1
PORT=8000
